# Copia este archivo como .env (NO lo subas a git) y rellena con los datos de Neon.
# Neon te da: postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Aqui se separa en 3 partes y la URL empieza por jdbc:
DB_URL=jdbc:postgresql://ep-xxxx.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=tu_password

# URL(s) del frontend, separadas por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
