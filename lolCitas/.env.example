# Copia este archivo como .env (NO lo subas a git) y rellena con los datos de Neon.
# Neon -> tu proyecto -> "Connect" -> elige "Java" / JDBC
DB_URL=jdbc:postgresql://ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=tu_password

# URL(s) del frontend, separadas por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app
